---
// Shared click-to-enlarge viewer.
//
// The page-builder gallery has offered a "Click to enlarge (lightbox)" toggle
// since the rewrite and never implemented it — the section emitted
// data-lightbox and nothing anywhere read it. A working lightbox existed, but
// only inside GalleryGrid.astro (the /portfolio grid), hard-wired to fixed
// element ids, so it could not simply be reused: a page can hold several
// gallery sections and duplicate ids would collide.
//
// So this is one viewer, rendered once by Layout, driven by event delegation.
// Any gallery marked data-lightbox="true" gets it for free — grid, masonry and
// carousel alike — and the image list is read from whichever section was
// clicked, so each gallery pages through its own images only.
---

<div class="lb" data-lb hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image viewer">
  <button class="lb__close" data-lb-close aria-label="Close">&#x2715;</button>
  <button class="lb__arrow lb__prev" data-lb-prev aria-label="Previous image">&#x2039;</button>
  <figure class="lb__figure">
    <img class="lb__img" data-lb-img src="" alt="" />
    <figcaption class="lb__caption" data-lb-caption></figcaption>
  </figure>
  <button class="lb__arrow lb__next" data-lb-next aria-label="Next image">&#x203A;</button>
  <p class="lb__count" data-lb-count></p>
</div>

<script>
  const lb = document.querySelector('[data-lb]');
  if (lb) {
    const img = lb.querySelector('[data-lb-img]');
    const cap = lb.querySelector('[data-lb-caption]');
    const count = lb.querySelector('[data-lb-count]');
    let items = [];
    let i = 0;
    let lastFocus = null;

    const show = () => {
      const it = items[i];
      if (!it) return;
      img.src = it.src;
      img.alt = it.alt || '';
      cap.textContent = it.caption || '';
      cap.hidden = !it.caption;
      count.textContent = items.length > 1 ? `${i + 1} / ${items.length}` : '';
    };

    const open = (section, index) => {
      // Read the list fresh on open, so a gallery whose images changed (or a
      // carousel that cloned slides) still pages through the right set.
      items = [...section.querySelectorAll('[data-lb-src]')].map((el) => ({
        src: el.getAttribute('data-lb-src'),
        alt: el.getAttribute('alt') || '',
        caption: el.getAttribute('data-lb-caption') || '',
      }));
      i = Math.max(0, index);
      lastFocus = document.activeElement;
      lb.hidden = false;
      lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      show();
      lb.querySelector('[data-lb-close]').focus();
    };

    const close = () => {
      lb.hidden = true;
      lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      img.src = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    };

    const step = (n) => {
      if (!items.length) return;
      i = (i + n + items.length) % items.length;
      show();
    };

    // Delegated: works for galleries that don't exist yet at script time.
    document.addEventListener('click', (e) => {
      const target = e.target.closest('[data-lb-src]');
      if (target) {
        const section = target.closest('[data-lightbox="true"]');
        if (!section) return;
        const all = [...section.querySelectorAll('[data-lb-src]')];
        open(section, all.indexOf(target));
        return;
      }
      if (e.target.closest('[data-lb-close]')) return close();
      if (e.target.closest('[data-lb-prev]')) return step(-1);
      if (e.target.closest('[data-lb-next]')) return step(1);
      // Backdrop click, but not a click on the image itself.
      if (!lb.hidden && e.target === lb) close();
    });

    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') step(-1);
      else if (e.key === 'ArrowRight') step(1);
    });
  }
</script>

<style>
  .lb {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(0, 0, 0, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  .lb[hidden] { display: none; }

  .lb__figure {
    margin: 0;
    max-width: min(1400px, calc(100vw - 8rem));
    max-height: calc(100vh - 6rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .lb__img {
    max-width: 100%;
    max-height: calc(100vh - 9rem);
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }
  .lb__caption {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.9rem;
    text-align: center;
    margin: 0;
  }
  .lb__count {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    margin: 0;
  }

  .lb__close,
  .lb__arrow {
    position: absolute;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: #fff;
    cursor: pointer;
    border-radius: 50%;
    display: grid;
    place-items: center;
    transition: background 0.2s;
  }
  .lb__close:hover,
  .lb__arrow:hover { background: rgba(255, 255, 255, 0.25); }
  .lb__close {
    top: 1.25rem;
    right: 1.25rem;
    width: 44px;
    height: 44px;
    font-size: 1.1rem;
  }
  .lb__arrow {
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    font-size: 2.4rem;
    line-height: 1;
  }
  .lb__prev { left: 1.25rem; }
  .lb__next { right: 1.25rem; }

  @media (max-width: 700px) {
    .lb { padding: 1rem; }
    .lb__figure { max-width: calc(100vw - 2rem); }
    .lb__arrow { width: 40px; height: 40px; font-size: 1.9rem; }
    .lb__prev { left: 0.5rem; }
    .lb__next { right: 0.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lb__close, .lb__arrow { transition: none; }
  }
</style>
