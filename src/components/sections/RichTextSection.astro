---
import { paletteToStyle } from '../../lib/palette.js';
import { stegaClean } from '@sanity/client/stega';
import { renderBody } from '../../lib/portableText.js';
import { resolveLink } from '../../lib/links.js';

interface Props {
  section: any;
  isFirst?: boolean;
  ownsH1?: boolean;
  palette?: any;
}

const { section, isFirst = false, ownsH1 = false, palette } = Astro.props;
const style = paletteToStyle(palette);

const eyebrow = section?.eyebrow || '';
const heading = section?.heading || '';
const bodyHTML = renderBody(section?.body, { className: 'richtext__p' });
const textAlign = section?.textAlignment || 'left';
const maxWidth = section?.maxWidth || 'default';
const ctaText = section?.ctaText || '';
const ctaHref = resolveLink(section?.ctaLink, [Astro.url.hostname]);

const HeadingTag = ownsH1 ? 'h1' : 'h2';

const headingSize = stegaClean(section?.headingSize) || 'large';
---

<section
  class:list={['section', 'richtext', `richtext--mw-${maxWidth}`]}
  data-section-type="richTextSection"
  data-heading-size={headingSize}
  data-spacing={section?.spacing || 'normal'}
  data-space-top={section?.spacingOverride?.top && section.spacingOverride.top !== 'inherit' ? section.spacingOverride.top : undefined}
  data-space-bottom={section?.spacingOverride?.bottom && section.spacingOverride.bottom !== 'inherit' ? section.spacingOverride.bottom : undefined}
  data-text-align={textAlign}
  id={section?.sectionId || undefined}
  style={style}
>
  <div class="richtext__wrap">
    {eyebrow && <p class="richtext__eyebrow reveal reveal-delay-1">{eyebrow}</p>}
    {heading && <HeadingTag class="richtext__heading">{heading}</HeadingTag>}
    {bodyHTML && <div class="richtext__body reveal reveal-delay-2" set:html={bodyHTML} />}
    {ctaText && ctaHref && (
      <div class="richtext__footer reveal reveal-delay-3">
        <a class="richtext__cta" href={ctaHref}>{ctaText}</a>
      </div>
    )}
  </div>
</section>

<style>
  .richtext {
    background: var(--bg);
    color: var(--text);
  }
  .richtext__wrap {
    margin: 0 auto;
    padding-inline: 1.5rem;
  }
  .richtext--mw-narrow .richtext__wrap { max-width: 600px; }
  .richtext--mw-default .richtext__wrap { max-width: 760px; }
  .richtext--mw-wide .richtext__wrap { max-width: 1100px; }

  .richtext[data-text-align='center'] .richtext__wrap { text-align: center; }

  .richtext__eyebrow {
    /* Site-wide Subheading Case. The toggle in Theme Settings has always
       said it controls "hero subheadings (and any other section
       subheadings)" — but only the hero read these variables, so switching
       to Sentence case changed one section and left the rest uppercase.
       Defaults resolve to the same 0.22em/uppercase this hard-coded. */
    font-family: var(--font-sans, var(--font-body));
    font-style: normal;
    font-size: 0.7rem;
    letter-spacing: calc(var(--subheading-spacing-scale, 1) * 0.22em);
    text-transform: var(--subheading-transform, uppercase);
    color: var(--accent);
    margin: 0 0 1rem;
  }
  .richtext__heading {
    font-size: calc(clamp(1.85rem, 3.5vw, 2.85rem) * var(--heading-scale, 1));
    line-height: 1.2;
    color: var(--text);
    margin: 0 0 1.5rem;
  }
  .richtext__body :global(p),
  .richtext__body :global(.richtext__p) {
    font-size: 1.05rem;
    line-height: 1.85;
    margin: 0 0 1.25rem;
  }
  .richtext__body :global(h2) {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin: 2.25rem 0 1rem;
  }
  .richtext__body :global(h3) {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    margin: 1.75rem 0 0.75rem;
  }
  .richtext__body :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--muted);
  }
  /* Restore list markers — the global `ul { list-style: none }` reset in
     Layout.astro exists for nav lists and strips them from prose too. The blog
     body already re-adds them the same way; section prose never did, so a
     bulleted answer rendered as a stack of unmarked lines.
     `li` also has to repeat the paragraph's font-size: without it the list
     inherits the smaller base size and reads as a different font mid-answer. */
  .richtext__body :global(ul) {
    list-style: disc outside;
    padding-left: 1.5rem;
    margin: 0 0 1.25rem;
  }
  .richtext__body :global(ol) {
    list-style: decimal outside;
    padding-left: 1.5rem;
    margin: 0 0 1.25rem;
  }
  .richtext__body :global(li) {
    font-size: 1.05rem;
    line-height: 1.85;
    margin: 0.4rem 0;
  }
  .richtext__body :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }

  /* Optional rectangular button. Mirrors .ctaband__cta — same palette
     variables, same metrics — and inherits the global lift-on-hover
     transition from Layout.astro's [class*="__cta"]:hover rule.
     Wrapper avoids the __cta / __btn / __button substrings: the global
     interaction rule uses [class*="__cta"] etc, which would match a
     wrapper named `__cta-wrap` and cause the entire wrapper width to
     lift on hover instead of just the button itself. */
  .richtext__footer {
    margin-top: 2rem;
  }
  .richtext[data-text-align='center'] .richtext__footer { text-align: center; }

  .richtext__cta {
    display: inline-block;
    font-family: var(--font-sans, var(--font-body));
    font-style: normal;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--btn-text);
    background: var(--btn-bg);
    padding: 1rem 2.25rem;
    white-space: nowrap;
  }

  /* Keep the section's vertical padding visually symmetric. Portable-text
     blocks carry a bottom margin (p = 1.25rem), so without this the last
     block's margin stacks under the section's padding-bottom and the gap below
     looks larger than above — very noticeable at the new "Short" spacing.
     MUST come after the .richtext__p / heading rules: they share this rule's
     specificity, so source order is what makes the reset win. (:global because
     the body HTML is injected via set:html.) */
  .richtext__wrap > :first-child { margin-top: 0; }
  .richtext__wrap > :last-child { margin-bottom: 0; }
  .richtext__body > :global(:first-child) { margin-top: 0; }
  .richtext__body > :global(:last-child) { margin-bottom: 0; }
</style>
