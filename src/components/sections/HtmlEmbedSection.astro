---
import { paletteToStyle } from '../../lib/palette.js';

interface Props {
  section: any;
  isFirst?: boolean;
  palette?: any;
}

const { section, palette } = Astro.props;
const style = paletteToStyle(palette);

// `section` is an htmlEmbedRef wrapper with a dereferenced `embed` field
// pointing at an htmlEmbedSection document.
const embed = section?.embed ?? null;
const rawHtml = embed?.rawHtml || '';
const containerWidth = embed?.containerWidth || 'default';
const containerHeight = embed?.containerHeight || null;
const heightStyle = containerHeight ? `min-height:${containerHeight}px;` : '';
---

<section
  class:list={['section', 'embed', `embed--${containerWidth}`]}
  data-section-type="htmlEmbedSection"
  data-spacing={section?.spacing || 'normal'}
  data-space-top={section?.spacingOverride?.top && section.spacingOverride.top !== 'inherit' ? section.spacingOverride.top : undefined}
  data-space-bottom={section?.spacingOverride?.bottom && section.spacingOverride.bottom !== 'inherit' ? section.spacingOverride.bottom : undefined}
  id={section?.sectionId || undefined}
  style={style}
>
  <div class="embed__inner" style={heightStyle}>
    {rawHtml
      ? <Fragment set:html={rawHtml} />
      : <p class="embed__placeholder">HTML Embed not configured. Pick an embed in Studio.</p>}
  </div>
</section>

<script>
  // Astro's set:html goes in as innerHTML, and the HTML spec marks any
  // <script> inserted that way as "already started" — the browser never runs
  // it. So every script-based embed has been silently inert: the markup is
  // present, nothing executes, and the section renders as an empty band with
  // its normal padding. Chaltron Photography's Flodesk newsletter looked like
  // a mysterious gap above the footer on nine pages.
  //
  // iframe embeds (her CloudSpot booking form) were unaffected, which is why
  // this went unnoticed — the field's own description promises "scripts that
  // will run on your live site".
  //
  // Re-creating each script element makes it run. Sequential, awaiting each
  // external script, so a loader followed by an init call still executes in
  // order.
  (async () => {
    const hosts = document.querySelectorAll('[data-section-type="htmlEmbedSection"] .embed__inner');
    for (const host of hosts) {
      for (const old of [...host.querySelectorAll('script')]) {
        const s = document.createElement('script');
        for (const { name, value } of [...old.attributes]) s.setAttribute(name, value);
        s.textContent = old.textContent;
        const done = s.src
          ? new Promise((res) => { s.onload = res; s.onerror = res; })
          : Promise.resolve();
        old.replaceWith(s);
        await done;
      }
    }
  })();
</script>

<style>
  .embed {
    background: var(--bg);
    color: var(--text);
  }
  .embed__inner {
    margin: 0 auto;
    padding-inline: 1.5rem;
  }
  .embed--narrow .embed__inner { max-width: 600px; }
  .embed--default .embed__inner { max-width: 760px; }
  .embed--wide .embed__inner { max-width: 1100px; }
  .embed--full .embed__inner { max-width: none; padding-inline: 0; }

  .embed__placeholder {
    text-align: center;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
