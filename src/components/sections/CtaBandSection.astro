---
import SanityImage from '../SanityImage.astro';
import ImagePlaceholder from '../ImagePlaceholder.astro';
import { paletteToStyle } from '../../lib/palette.js';
import { renderHeading } from '../../lib/heading.js';
import { resolveLink } from '../../lib/links.js';
import { buildSrc } from '../../lib/image';

interface Props {
  section: any;
  isFirst?: boolean;
  ownsH1?: boolean;
  palette?: any;
}

const { section, isFirst = false, ownsH1 = false, palette } = Astro.props;
const style = paletteToStyle(palette);

const heading = renderHeading(section?.heading || '');
const body = section?.body || '';
const ctaText = section?.ctaText || '';
const ctaHref = resolveLink(section?.ctaLink, [Astro.url.hostname]);
// Optional second button beside the first (e.g. "Session info" + "Book").
const secondaryText = section?.secondaryCtaText || '';
const secondaryHref = resolveLink(section?.secondaryCtaLink, [Astro.url.hostname]);
const layout = section?.layout || 'centered';
const caption = section?.caption || '';
// Section height is editor-controlled but only meaningful for the
// centered layout — split-text and overlapping-images have their own
// height behavior. Default ('default') adds no class so existing
// sections render exactly as before.
const centeredHeight = section?.centeredHeight || 'default';
const heightClass =
  layout === 'centered' && centeredHeight !== 'default'
    ? `ctaband--height-${centeredHeight}`
    : null;

const bgImage = section?.backgroundImage ?? null;
const bgUrl = bgImage?.asset ? buildSrc(bgImage, 2000) : null;
const fgImage = section?.foregroundImage ?? null;
// Parallax only means anything with a CSS background image. The Overlapping
// Images layout renders real <img> elements instead, so it can't parallax.
const parallax = !!section?.parallax && !!bgUrl;

const isOverlapping = layout === 'overlapping-images';

const HeadingTag = ownsH1 ? 'h1' : 'h2';
---

{isOverlapping ? (
  <section
    class="section ctaband ctaband--overlapping-images"
    data-section-type="ctaBandSection"
    data-spacing={section?.spacing || 'normal'}
  data-space-top={section?.spacingOverride?.top && section.spacingOverride.top !== 'inherit' ? section.spacingOverride.top : undefined}
  data-space-bottom={section?.spacingOverride?.bottom && section.spacingOverride.bottom !== 'inherit' ? section.spacingOverride.bottom : undefined}
    data-mobile-flip-order={section?.mobileFlipOrder ? 'true' : undefined}
    id={section?.sectionId || undefined}
    style={style}
  >
    <hr />
    <div class="ctaband__oi-inner">
      <div class="ctaband__oi-images">
        <div class="ctaband__oi-back">
          {bgImage
            ? <SanityImage image={bgImage} sizes="(max-width:900px) 100vw, 75vw" loading="lazy" class="ctaband__oi-back-img" />
            : <ImagePlaceholder class="ctaband__oi-back-img" />}
        </div>
      </div>
      <div class="ctaband__oi-content">
        {heading && <HeadingTag class="ctaband__oi-heading reveal reveal-delay-1" set:html={heading} />}
        {body && <p class="ctaband__oi-body reveal reveal-delay-2">{body}</p>}
        {ctaText && ctaHref && <a class="ctaband__oi-btn reveal reveal-delay-3" href={ctaHref}>{ctaText}</a>}
        {secondaryText && secondaryHref && <a class="ctaband__oi-btn ctaband__oi-btn--secondary reveal reveal-delay-3" href={secondaryHref}>{secondaryText}</a>}
        {caption && <p class="ctaband__oi-caption">{caption}</p>}
      </div>
      <div class="ctaband__oi-front">
        {fgImage
          ? <SanityImage image={fgImage} sizes="(max-width:900px) 80vw, 40vw" loading="lazy" class="ctaband__oi-front-img" />
          : <ImagePlaceholder class="ctaband__oi-front-img" aspectRatio="25/32" size="w" />}
      </div>
    </div>
  </section>
) : (
  <section
    class:list={['section', 'ctaband', `ctaband--${layout}`, bgUrl ? 'ctaband--has-bg' : '', heightClass]}
    data-section-type="ctaBandSection"
    data-spacing={section?.spacing || 'normal'}
    data-space-top={section?.spacingOverride?.top && section.spacingOverride.top !== 'inherit' ? section.spacingOverride.top : undefined}
    data-space-bottom={section?.spacingOverride?.bottom && section.spacingOverride.bottom !== 'inherit' ? section.spacingOverride.bottom : undefined}
    data-parallax={parallax ? 'true' : 'false'}
    id={section?.sectionId || undefined}
    style={style}
  >
    {bgUrl && (
      <>
        <div class="ctaband__bg" style={`background-image:url('${bgUrl}')`} aria-hidden="true"></div>
        <div class="ctaband__overlay" aria-hidden="true"></div>
      </>
    )}
    <div class="ctaband__inner">
      <div class="ctaband__text reveal">
        {heading && <HeadingTag class="ctaband__heading" set:html={heading} />}
        {body && <p class="ctaband__body">{body}</p>}
      </div>
      {ctaText && ctaHref && (
        <div class="ctaband__footer reveal reveal-delay-1">
          <a class="ctaband__cta" href={ctaHref}>{ctaText}</a>
          {secondaryText && secondaryHref && (
            <a class="ctaband__cta ctaband__cta--secondary" href={secondaryHref}>{secondaryText}</a>
          )}
        </div>
      )}
    </div>
  </section>
)}

<style>
  /* Tone-aware. The section's Background Tone radio (Light/Alt/Dark)
     is resolved into the palette via applyBackgroundTone() in the
     renderer, which swaps --bg to the chosen shade. Binding to --bg
     (not --bg-alt) is what makes Light actually render as light;
     previously this section ignored the toggle and always used the
     alt shade. */
  .ctaband {
    position: relative;
    background: var(--bg);
    color: var(--text);
    overflow: hidden;
  }
  .ctaband--has-bg { color: var(--white, #fff); }
  .ctaband__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  /* Parallax: image holds still while the band scrolls past. Matches
     FullBleedImageSection. iOS Safari ignores background-attachment: fixed,
     and on narrow screens the effect mostly reads as a rendering glitch, so
     it falls back to a normal scroll below 900px. */
  .ctaband[data-parallax='true'] .ctaband__bg {
    background-attachment: fixed;
  }
  @media (max-width: 900px) {
    .ctaband[data-parallax='true'] .ctaband__bg {
      background-attachment: scroll;
    }
  }
  .ctaband__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  .ctaband__inner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding-inline: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.75rem;
  }

  /* Height variants for the Centered layout. Default (no class) is
     content-driven — section height = content + data-spacing padding,
     identical to the historical behavior. Tall and Viewport set a
     min-height and flex-center the inner so content sits at the
     midpoint of the larger box. Mobile drops the min-height entirely
     so phones never get stuck with empty space at the top/bottom of
     a short CTA. */
  .ctaband--height-tall,
  .ctaband--height-viewport {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .ctaband--height-tall { min-height: 520px; }
  .ctaband--height-viewport { min-height: 100vh; }

  @media (max-width: 768px) {
    .ctaband--height-tall,
    .ctaband--height-viewport {
      min-height: 0;
    }
  }
  .ctaband--split-text-left-cta-right .ctaband__inner {
    flex-direction: row;
    justify-content: space-between;
    text-align: left;
    align-items: center;
  }

  .ctaband__heading {
    font-size: clamp(1.85rem, 3.5vw, 2.85rem);
    line-height: 1.18;
    margin: 0 0 0.75rem;
  }
  .ctaband--has-bg .ctaband__heading { color: var(--white, #fff); }
  .ctaband__body {
    font-size: 1.05rem;
    line-height: 1.7;
    color: inherit;
    margin: 0;
    max-width: 560px;
  }
  .ctaband--split-text-left-cta-right .ctaband__body { max-width: none; }

  /* Two buttons sit side by side and wrap together on narrow screens. The
     second is outlined so the primary action still reads as primary. */
  .ctaband__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
  .ctaband__cta--secondary,
  .ctaband__oi-btn--secondary {
    background: transparent;
    color: currentColor;
    border: 1px solid currentColor;
  }
  .ctaband__cta {
    display: inline-block;
    font-family: var(--font-sans, var(--font-body));
    font-style: normal;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--btn-text);
    background: var(--btn-bg);
    padding: 1rem 2.25rem;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .ctaband--split-text-left-cta-right .ctaband__inner {
      flex-direction: column;
      text-align: center;
    }
  }

  /* ── Overlapping Images variant ── */
  .ctaband--overlapping-images {
    background: var(--bg);
    color: var(--text);
    padding: 0 0 7rem;
  }
  .ctaband__oi-inner {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    padding: 6rem 3rem 7rem;
    min-height: 1020px;
  }

  .ctaband__oi-images {
    position: relative;
    margin-left: 25%;
    height: 900px;
  }
  .ctaband__oi-back {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    overflow: hidden;
    border: 20px solid white;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }
  .ctaband__oi-back img,
  .ctaband__oi-back :global(.ctaband__oi-back-img) {
    width: 100%;
    display: block;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .ctaband__oi-front {
    position: absolute;
    top: calc(6rem + 240px);
    left: 3rem;
    width: 43%;
    overflow: hidden;
    border: 20px solid white;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.14);
  }
  .ctaband__oi-front img,
  .ctaband__oi-front :global(.ctaband__oi-front-img) {
    width: 100%;
    display: block;
    height: 520px;
    object-fit: cover;
  }

  .ctaband__oi-content {
    position: absolute;
    top: calc(6rem + 475px + 100px);
    left: calc(43% + 100px);
    right: 3rem;
  }
  .ctaband__oi-heading {
    font-size: clamp(2.25rem, 4vw, 3.75rem);
    color: var(--text);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }
  .ctaband__oi-body {
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.82;
    color: var(--text);
    margin-bottom: 2.5rem;
    max-width: 420px;
  }
  .ctaband__oi-btn {
    display: inline-block;
    font-family: var(--font-sans, var(--font-body));
    font-style: normal;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--text);
    padding: 0.7rem 1.75rem;
    margin-bottom: 1.5rem;
    transition: background 0.25s, color 0.25s, transform 0.25s, box-shadow 0.25s;
  }
  .ctaband__oi-btn:hover {
    background: var(--text);
    color: var(--bg);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
  }
  .ctaband__oi-caption {
    font-family: var(--font-sans, var(--font-body));
    font-size: 0.8125rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  @media (max-width: 900px) {
    .ctaband__oi-inner {
      padding: 4rem 1.5rem 4rem;
      min-height: 0;
    }
    .ctaband__oi-images {
      margin-left: 0;
      height: auto;
    }
    .ctaband__oi-back {
      position: static;
    }
    .ctaband__oi-back img,
    .ctaband__oi-back :global(.ctaband__oi-back-img) {
      height: auto;
      aspect-ratio: 3 / 2;
    }
    .ctaband__oi-front {
      position: static;
      width: 80%;
      margin-top: 2rem;
    }
    .ctaband__oi-front img,
    .ctaband__oi-front :global(.ctaband__oi-front-img) {
      height: auto;
    }
    .ctaband__oi-content {
      position: static;
      width: 100%;
      padding-top: 2.5rem;
    }

    /* Editor toggle: text ABOVE both images instead of sandwiched between
       them. Default mobile flow is block (back image → content → front
       image); the flipped variant becomes a flex column so `order` works. */
    .ctaband--overlapping-images[data-mobile-flip-order='true'] .ctaband__oi-inner {
      display: flex;
      flex-direction: column;
    }
    .ctaband--overlapping-images[data-mobile-flip-order='true'] .ctaband__oi-content {
      order: 1;
      padding-top: 0;
    }
    .ctaband--overlapping-images[data-mobile-flip-order='true'] .ctaband__oi-images {
      order: 2;
      margin-top: 2.5rem;
    }
    .ctaband--overlapping-images[data-mobile-flip-order='true'] .ctaband__oi-front {
      order: 3;
    }
  }
</style>
